# Cloudflare Pages — headers customizados
# Evita que o navegador/edge sirva uma cópia antiga desses arquivos por muito
# tempo, senão o Service Worker demora a perceber que existe uma versão nova
# (o app.js/etc. já usam ?v=NN pra cache-busting, mas o shell abaixo precisa
# ser revalidado com frequência pra essa versão nova ser sequer descoberta).
/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/dashboard.html
  Cache-Control: no-cache
